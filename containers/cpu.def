Bootstrap: docker
From: python@sha256:623674a14ef93d052bb9b0de4dbf5f28eb578a35263838941cc8aa43213c1487

# Python 3.12.16 slim-bookworm Linux/amd64 manifest; digest-only Apptainer syntax.
# Owner stages a verified wheel/receipt and this exact revision's Git archive.

%files
    pyproject.toml /opt/tsp/pyproject.toml
    uv.lock /opt/tsp/uv.lock
    README.md /opt/tsp/README.md
    tests/problem /opt/tsp/tests/problem
    tests/reproducibility /opt/tsp/tests/reproducibility
    tests/solvers /opt/tsp/tests/solvers
    tests/experiments /opt/tsp/tests/experiments
    tests/analysis /opt/tsp/tests/analysis
    tests/integration/test_cli.py /opt/tsp/tests/integration/test_cli.py
    tests/integration/test_native_runtime.py /opt/tsp/tests/integration/test_native_runtime.py
    examples/instances /opt/tsp/examples/instances
    examples/manifests /opt/tsp/examples/manifests
    examples/references /opt/tsp/examples/references
    containers/cpu.def /opt/tsp/container.def
    containers/bootstrap-requirements.txt /opt/tsp/bootstrap-requirements.txt
    containers/check_runtime.py /opt/tsp/check_runtime.py
    .image-build/wheels /opt/tsp/wheels
    .image-build/source-revision /opt/tsp/source-revision

%post
    set -eu
    unset PYTHONPATH PYTHONHOME VIRTUAL_ENV
    export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
    export UV_NO_CONFIG=1 UV_NO_CACHE=1 UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy
    export UV_PROJECT_ENVIRONMENT=/opt/tsp/.venv
    export NUMBA_NUM_THREADS=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1

    cd /opt/tsp
    # Check the retained archive/receipt and staged inputs before installing code.
    wheel=$(/usr/local/bin/python3.12 -I -B /opt/tsp/check_runtime.py --check-wheel)
    /usr/local/bin/python3.12 -I -B -m pip install \
        --no-cache-dir --no-deps --only-binary=:all: --require-hashes \
        -r /opt/tsp/bootstrap-requirements.txt
    # dev includes pytest and analysis, not the optional interface extra.
    /usr/local/bin/uv sync --locked --no-install-project --no-sources \
        --no-default-groups --group dev --no-managed-python \
        --python /usr/local/bin/python3.12
    /usr/local/bin/uv pip install --python /opt/tsp/.venv/bin/python --no-deps "$wheel"
    /opt/tsp/.venv/bin/python -I -B /opt/tsp/check_runtime.py --record-build
    mkdir -p /inputs /outputs /cache/tmp /cache/numba /cache/xdg /cache/matplotlib

%environment
    export PATH=/opt/tsp/.venv/bin:/usr/local/bin:/usr/bin:/bin
    export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
    unset PYTHONPATH PYTHONHOME VIRTUAL_ENV
    export TMPDIR=/cache/tmp
    export XDG_CACHE_HOME=/cache/xdg
    export MPLCONFIGDIR=/cache/matplotlib
    export NUMBA_CACHE_DIR=/cache/numba
    export NUMBA_NUM_THREADS=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1

%runscript
    exec /opt/tsp/.venv/bin/python -I -B -m tsp_hpc "$@"

%test
    set -eu
    # Build-time tests must not depend on runtime binds or write into the image.
    work=$(mktemp -d /tmp/tsp-image-test.XXXXXX)
    trap 'rm -rf -- "$work"' EXIT
    export TMPDIR="$work/tmp" XDG_CACHE_HOME="$work/xdg" MPLCONFIGDIR="$work/matplotlib"
    export NUMBA_CACHE_DIR="$work/numba"
    export NUMBA_NUM_THREADS=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
    mkdir -p "$TMPDIR" "$XDG_CACHE_HOME" "$MPLCONFIGDIR" "$NUMBA_CACHE_DIR"
    /opt/tsp/.venv/bin/python -I -B /opt/tsp/check_runtime.py --output "$work/check"

%labels
    org.opencontainers.image.title tsp-hpc CPU environment
    org.opencontainers.image.description Verified application wheel, locked analysis and scientific tests; no GPU or MPI runtime

%help
    CPU application image for Linux x86_64: run/analyze serial NN campaigns.
    Use clean environment/containment and explicit input, output and cache mounts.
    /opt/tsp/build-info.json binds the installed build to its retained wheel receipt.
    Final SIF checksums are retained externally. See docs/hpc-resources.md.
